<?xml version="1.0"?>
<!-- Motoman UP50N-35, the long-reach UP50N, kinematic chain, without meshes.

     Joint origins, axes and limits are those of riact's model of the arm
     (riact_models motoman_description/urdf/up50n_35_macro.xacro), which
     drew a real one correctly in riflex: 1.150 m from L to U and 1.225 m
     from U to the wrist, where the YR-UP50N has 0.870 m and 1.025 m.
     The root is the controller's robot base frame, 0.54 m above the
     macro's base_link, so poses come out as an NX100 reports them.

     The flange frame turns +90 degrees about Y from the base frame, so
     at the zero position its Z points out of the flange along base +X.
     This follows Yaskawa's flange convention as far as we know it; check
     it against RPOSC on a real controller before relying on Rx Ry Rz. -->
<robot name="yr_up50n_35">
  <link name="base"/>
  <link name="link_1_s"/>
  <link name="link_2_l"/>
  <link name="link_3_u"/>
  <link name="link_4_r"/>
  <link name="link_5_b"/>
  <link name="link_6_t"/>
  <link name="flange"/>

  <joint name="joint_1_s" type="revolute">
    <parent link="base"/>
    <child link="link_1_s"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1415" upper="3.1415" effort="3430" velocity="2.44346"/>
  </joint>
  <joint name="joint_2_l" type="revolute">
    <parent link="link_1_s"/>
    <child link="link_2_l"/>
    <origin xyz="0.145 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="2.3561" effort="5488" velocity="2.44346"/>
  </joint>
  <joint name="joint_3_u" type="revolute">
    <parent link="link_2_l"/>
    <child link="link_3_u"/>
    <origin xyz="0 0 1.150" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-1.3962" upper="3.5953" effort="2021" velocity="2.44346"/>
  </joint>
  <joint name="joint_4_r" type="revolute">
    <parent link="link_3_u"/>
    <child link="link_4_r"/>
    <origin xyz="1.225 0 0.110" rpy="0 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit lower="-6.2831" upper="6.2831" effort="540" velocity="4.36332"/>
  </joint>
  <joint name="joint_5_b" type="revolute">
    <parent link="link_4_r"/>
    <child link="link_5_b"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-2.1816" upper="2.1816" effort="361" velocity="4.36332"/>
  </joint>
  <joint name="joint_6_t" type="revolute">
    <parent link="link_5_b"/>
    <child link="link_6_t"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit lower="-6.2831" upper="6.2831" effort="259" velocity="6.10865"/>
  </joint>
  <joint name="joint_6_t-flange" type="fixed">
    <parent link="link_6_t"/>
    <child link="flange"/>
    <origin xyz="0.175 0 0" rpy="0 1.5707963 0"/>
  </joint>
</robot>
