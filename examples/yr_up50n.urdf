<?xml version="1.0"?>
<!-- Motoman YR-UP50N (MH50 family) kinematic chain, without meshes.

     Joint origins, axes and limits are those of ROS-Industrial's
     motoman_mh50 macro (the yrup50n_macro.xacro in the Yaskawa folder).
     The root is the controller's robot base frame, 0.54 m above the
     macro's base_link, so poses come out as an NX100 reports them.

     The flange frame turns +90 degrees about Y from the base frame, so
     at the zero position its Z points out of the flange along base +X.
     This follows Yaskawa's flange convention as far as we know it; check
     it against RPOSC on a real controller before relying on Rx Ry Rz. -->
<robot name="yr_up50n">
  <link name="base"/>
  <link name="link_1_s"/>
  <link name="link_2_l"/>
  <link name="link_3_u"/>
  <link name="link_4_r"/>
  <link name="link_5_b"/>
  <link name="link_6_t"/>
  <link name="flange"/>

  <joint name="joint_1_s" type="revolute">
    <parent link="base"/>
    <child link="link_1_s"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="4903.32" velocity="2.97"/>
  </joint>
  <joint name="joint_2_l" type="revolute">
    <parent link="link_1_s"/>
    <child link="link_2_l"/>
    <origin xyz="0.145 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57079" upper="2.35619" effort="6276.26" velocity="2.97"/>
  </joint>
  <joint name="joint_3_u" type="revolute">
    <parent link="link_2_l"/>
    <child link="link_3_u"/>
    <origin xyz="0 0 0.870" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-1.39626" upper="3.59538" effort="2745.86" velocity="2.97"/>
  </joint>
  <joint name="joint_4_r" type="revolute">
    <parent link="link_3_u"/>
    <child link="link_4_r"/>
    <origin xyz="1.025 0 0.110" rpy="0 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit lower="-6.28319" upper="6.28319" effort="823.76" velocity="4.36"/>
  </joint>
  <joint name="joint_5_b" type="revolute">
    <parent link="link_4_r"/>
    <child link="link_5_b"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-2.18167" upper="2.18167" effort="706.08" velocity="4.36"/>
  </joint>
  <joint name="joint_6_t" type="revolute">
    <parent link="link_5_b"/>
    <child link="link_6_t"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit lower="-6.2831" upper="6.2831" effort="333.43" velocity="6.11"/>
  </joint>
  <joint name="joint_6_t-flange" type="fixed">
    <parent link="link_6_t"/>
    <child link="flange"/>
    <origin xyz="0.175 0 0" rpy="0 1.5707963 0"/>
  </joint>
</robot>
