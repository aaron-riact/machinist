/JOB
//NAME SEARCH
//POS
///NPOS 0,0,0,0,0,0
//INST
///DATE 2026/01/01 00:00
///COMM SEARCH FOR AN EDGE WITH THE LASER
///ATTR SC,RW
///GROUP1 RB1
NOP
'LASER ON, AND WAIT UNTIL IT IS READY
DOUT OT#(9) ON
WAIT IN#(9)=ON T=3.00
TCPON TL#(1)
'SEARCH UP TO 300 MM ALONG BASE X
GETS PX001 $PX001
SUB P001 P001
SETE P001 (1) 300000
IMOV P001 V=20.0 BF SRCH RIN#(1)=ON DIS=2.0
'B000 1: FOUND. P002: WHERE, AS THE LASER'S POINT
GETS B000 $B002
GETS PX002 $PX003
DOUT OT#(9) OFF
END
